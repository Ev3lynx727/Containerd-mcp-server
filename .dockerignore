# ============================================
# Docker Build Context Exclusions
# ============================================
# Exclude files that shouldn't be in Docker build context

# Version Control
.git
.gitignore
.gitattributes
.github

# Dependencies (will be installed in container)
node_modules
npm-debug.log
yarn-error.log
package-lock.json

# Environment Files (sensitive data)
.env
.env.local
.env.*.local
.env.gateway
config/.env

# But include example files
!.env.example
!.envexample

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache and temporary files
.ruff_cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist
build
.cache
tmp
temp
*.tmp
*.swp
*.swo

# IDE and Editor files
.vscode
.idea
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Documentation (not needed in runtime)
docs
*.md
!README.md

# Test files (not needed in production)
test
tests
*.test.js
*.spec.js
coverage

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Data directories
mcp-data
logs

# Scripts not needed in container
*.sh
!start-mcp-servers.sh

# Other
.dockerignore
Dockerfile*
docker-compose*.yml
