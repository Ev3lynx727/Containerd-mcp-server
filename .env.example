# ============================================
# MCP Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# --------------------------------------------
# API Keys and Authentication
# --------------------------------------------

# Context7 API key (required for context7 MCP server)
# Get your API key from: https://context7.com
CONTEXT7_API_KEY=

# Auth Bearer token (optional, for authenticated MCP endpoints)
# Used for securing MCP server endpoints
AUTH_BEARER=

# --------------------------------------------
# Service Configuration
# --------------------------------------------

# REST API base URL (optional)
# Default: https://api.example.com
REST_BASE_URL=https://api.example.com

# --------------------------------------------
# Node.js Configuration
# --------------------------------------------

# Node.js memory limit (in MB)
# Default: 2048
# NODE_OPTIONS=--max-old-space-size=2048

# Node module resolution path
# Default: /app/node_modules
# NODE_PATH=/app/node_modules

# --------------------------------------------
# MCP Gateway Configuration
# --------------------------------------------

# MCP Gateway authentication token (generated by setup_mcp_gateway.sh)
# This is typically auto-generated and stored in .env.gateway
# MCP_GATEWAY_TOKEN=

# --------------------------------------------
# Docker Configuration
# --------------------------------------------

# These are typically set by docker-compose.yml
# Uncomment if you need to override defaults

# CPU limit for container
# DOCKER_CPU_LIMIT=2.0

# Memory limit for container
# DOCKER_MEMORY_LIMIT=2G

# --------------------------------------------
# Development/Debug Settings
# --------------------------------------------

# Enable debug logging (uncomment to enable)
# DEBUG=*

# Log level (error, warn, info, debug)
# LOG_LEVEL=info
