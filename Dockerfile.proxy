FROM node:24

# Create app directory
WORKDIR /app

# Copy package.json and install dependencies
COPY package.json /app/package.json
RUN npm install

# Copy server script
COPY netdata-mcp-server-simple.js /app/netdata-mcp-server-simple.js

# Expose port
EXPOSE 3051

# Run the server
CMD ["node", "/app/netdata-mcp-server-simple.js"]