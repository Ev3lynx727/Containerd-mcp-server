FROM node:24

# Create app directory
WORKDIR /app

# Copy package.json and install dependencies
COPY package.json /app/package.json
RUN npm install

# Copy server script
COPY netdata-mcp-server.js /app/netdata-mcp-server.js

# Expose port
EXPOSE 3003

# Run the server
CMD ["node", "netdata-mcp-server.js"]